{
  "description": "Five required Git BBQ lifecycle hooks. The Go hook process receives one JSON event, validates the known event, and exits.",
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/runtime/git-bbq/git-bbq\" hook UserPromptSubmit", "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\git-bbq\\git-bbq.cmd\" hook UserPromptSubmit", "timeout": 5}]}],
    "PreToolUse": [{"matcher": "^(Bash|apply_patch|Edit|Write)$", "hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/runtime/git-bbq/git-bbq\" hook PreToolUse", "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\git-bbq\\git-bbq.cmd\" hook PreToolUse", "timeout": 5}]}],
    "PostToolUse": [{"matcher": "^(apply_patch|Edit|Write)$", "hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/runtime/git-bbq/git-bbq\" hook PostToolUse", "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\git-bbq\\git-bbq.cmd\" hook PostToolUse", "timeout": 5}]}],
    "PostCompact": [{"matcher": "manual|auto", "hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/runtime/git-bbq/git-bbq\" hook PostCompact", "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\git-bbq\\git-bbq.cmd\" hook PostCompact", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/runtime/git-bbq/git-bbq\" hook Stop", "commandWindows": "& \"$env:PLUGIN_ROOT\\runtime\\git-bbq\\git-bbq.cmd\" hook Stop", "timeout": 5}]}]
  }
}
