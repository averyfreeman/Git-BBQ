{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/averyfreeman/git-bbq/blob/main/schemas/gitbbq/matt-skills-manifest.schema.json",
  "title": "Git BBQ packaged Matt skills manifest",
  "type": "object",
  "required": ["repository", "commit", "skills"],
  "properties": {
    "repository": { "type": "string", "format": "uri" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourcePath", "publicName", "aliasOf", "repository", "commit"],
        "properties": {
          "sourcePath": { "type": "string", "pattern": "^skills/[^/]+/.+" },
          "publicName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "aliasOf": { "type": ["string", "null"] },
          "repository": { "type": "string", "format": "uri" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
